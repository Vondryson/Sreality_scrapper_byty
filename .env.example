# Safe local-development example. Do not add real production credentials.
SREALITY_ENVIRONMENT=local
SREALITY_DATABASE_URL=postgresql+psycopg://sreality:sreality_local_only@localhost:5432/sreality_tracker
SREALITY_STORAGE_BACKEND=local
# Required only when SREALITY_STORAGE_BACKEND=gcs. The production values are fixed and validated.
# SREALITY_GCP_PROJECT_ID=sreality-scrapper-504307
# SREALITY_STORAGE_BUCKET=sreality-scrapper-504307-application-data
SREALITY_RAW_STORAGE_PATH=data/raw
SREALITY_LOG_LEVEL=INFO
SREALITY_HTTP_TIMEOUT_SECONDS=20
SREALITY_HTTP_MIN_DELAY_SECONDS=0.75
SREALITY_HTTP_MAX_ATTEMPTS=3
SREALITY_HTTP_BACKOFF_BASE_SECONDS=0.5
SREALITY_HTTP_JITTER_MAX_SECONDS=0.25
# Optional Google Routes wiring. Supply only a short-lived token in the process environment.
# SREALITY_ROUTES_PROJECT_ID=sreality-scrapper-504307
# SREALITY_ROUTES_ACCESS_TOKEN=
SREALITY_ROUTES_DAILY_REQUEST_LIMIT=300
SREALITY_ROUTES_MAX_ATTEMPTS=3

# Google OAuth for the private web application. Keep both secrets out of Git.
SREALITY_GOOGLE_OAUTH_CLIENT_ID=
SREALITY_GOOGLE_OAUTH_CLIENT_SECRET=
SREALITY_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SREALITY_FRONTEND_URL=http://localhost:3000
SREALITY_OWNER_EMAIL=
SREALITY_SESSION_SECRET=
